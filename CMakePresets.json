{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 3,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true
		},
		{
			"name": "linux-gcc-debug",
			"inherits": "base",
			"displayName": "linux_gcc_debug",
			"description": "Debug build with GCC (uses KP_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-gcc-release",
			"inherits": "base",
			"displayName": "linux_gcc_release",
			"description": "Release build with GCC (uses KP_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-gcc-relwithdebinfo",
			"inherits": "base",
			"displayName": "linux_gcc_relwithdebinfo",
			"description": "Optimised build with symbols, using GCC (uses KP_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-RelWithDebInfo",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-gcc-ubsan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_ubsan",
			"description": "UndefinedBehaviorSanitizer with GCC, on top of RelWithDebInfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-ubsan",
			"cacheVariables": {
				"KP_SANITIZER": "undefined"
			}
		},
		{
			"name": "linux-gcc-asanubsan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_asanubsan",
			"description": "Address and UndefinedBehaviorSanitizer together with GCC, on top of RelWithDebInfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-asanubsan",
			"cacheVariables": {
				"KP_SANITIZER": "address,undefined"
			}
		},
		{
			"name": "linux-gcc-asan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_asan",
			"description": "AddressSanitizer with GCC, on top of RelWithDebInfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-asan",
			"cacheVariables": {
				"KP_SANITIZER": "address"
			}
		},
		{
			"name": "linux-clang-debug",
			"inherits": "base",
			"displayName": "linux_clang_debug",
			"description": "Debug build with Clang (uses KP_CLANG_PATH or system Clang)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/clang-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/clang.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-clang-release",
			"inherits": "base",
			"displayName": "linux_clang_release",
			"description": "Release build with Clang (uses KP_CLANG_PATH or system Clang)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/clang-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/clang.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-clang-relwithdebinfo",
			"inherits": "base",
			"displayName": "linux_clang_relwithdebinfo",
			"description": "Optimised build with symbols, using Clang (uses KP_CLANG_PATH or system Clang)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/clang-RelWithDebInfo",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/clang.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "x86_64",
			"hidden": true,
			"cacheVariables": { "KP_ARCH": "x86_64" }
		},
		{
			"name": "linux-gcc-x86_64-release",
			"inherits": [ "x86_64", "linux-gcc-release" ],
			"displayName": "linux_gcc_x86_64_release",
			"description": "x86-64 Release build with GCC (uses KP_GCC_PATH or system GCC)",
			"binaryDir": "${sourceDir}/build/gcc-x86_64-Release"
		},
		{
			"name": "linux-gcc-x86_64-relwithdebinfo",
			"inherits": [ "x86_64", "linux-gcc-relwithdebinfo" ],
			"displayName": "linux_gcc_x86_64_relwithdebinfo",
			"description": "x86-64 optimised build with symbols, using GCC (uses KP_GCC_PATH or system GCC)",
			"binaryDir": "${sourceDir}/build/gcc-x86_64-RelWithDebInfo"
		},
		{
			"name": "linux-gcc-x86_64-asanubsan",
			"inherits": [ "x86_64", "linux-gcc-asanubsan" ],
			"displayName": "linux_gcc_x86_64_asanubsan",
			"description": "x86-64 ASan + UBSan build with GCC",
			"binaryDir": "${sourceDir}/build/gcc-x86_64-asanubsan"
		},
		{
			"name": "linux-clang-x86_64-release",
			"inherits": [ "x86_64", "linux-clang-release" ],
			"displayName": "linux_clang_x86_64_release",
			"description": "x86-64 Release build with Clang (uses KP_CLANG_PATH or system Clang)",
			"binaryDir": "${sourceDir}/build/clang-x86_64-Release"
		},
		{
			"name": "windows-msvc-debug",
			"inherits": "base",
			"displayName": "windows_msvc_debug",
			"description": "Debug build with MSVC — run from 'x64 Native Tools Command Prompt for VS 2026'",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/msvc-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows/msvc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "windows-msvc-release",
			"inherits": "base",
			"displayName": "windows_msvc_release",
			"description": "Release build with MSVC — run from 'x64 Native Tools Command Prompt for VS 2026'",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/msvc-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows/msvc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "windows-msvc-relwithdebinfo",
			"inherits": "base",
			"displayName": "windows_msvc_relwithdebinfo",
			"description": "Optimised build with symbols, using MSVC — run from 'x64 Native Tools Command Prompt for VS 2026'",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/msvc-RelWithDebInfo",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows/msvc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "linux-gcc-debug",
			"configurePreset": "linux-gcc-debug",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-release",
			"configurePreset": "linux-gcc-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-relwithdebinfo",
			"configurePreset": "linux-gcc-relwithdebinfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-ubsan",
			"configurePreset": "linux-gcc-ubsan",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-asanubsan",
			"configurePreset": "linux-gcc-asanubsan",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-asan",
			"configurePreset": "linux-gcc-asan",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-clang-debug",
			"configurePreset": "linux-clang-debug",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-clang-release",
			"configurePreset": "linux-clang-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-clang-relwithdebinfo",
			"configurePreset": "linux-clang-relwithdebinfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-x86_64-release",
			"configurePreset": "linux-gcc-x86_64-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-x86_64-relwithdebinfo",
			"configurePreset": "linux-gcc-x86_64-relwithdebinfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-gcc-x86_64-asanubsan",
			"configurePreset": "linux-gcc-x86_64-asanubsan",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "linux-clang-x86_64-release",
			"configurePreset": "linux-clang-x86_64-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "windows-msvc-debug",
			"configurePreset": "windows-msvc-debug",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "windows-msvc-release",
			"configurePreset": "windows-msvc-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "windows-msvc-relwithdebinfo",
			"configurePreset": "windows-msvc-relwithdebinfo",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		}
	]
}
